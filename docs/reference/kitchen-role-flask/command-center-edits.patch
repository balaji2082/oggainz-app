+# ---------------------------------------------------------------------------
+@app.route("/staff")
+def staff():
+    c = conn()
+    people = auth.staff_list(c, active_only=False)
+    # Last 40 actions, so the page answers "did he mark tonight's run?" directly.
+    log = auth.recent(c, limit=40)
+    c.close()
+    return render_template("staff.html", people=people, log=log,
+                           roles=[("kitchen", "Kitchen & delivery"),
+                                  ("content", "Content / social media"),
+                                  ("owner", "Owner (full access)")])
+
+
+@app.route("/staff/new", methods=["POST"])
+def staff_new():
+    name = (request.form.get("name") or "").strip()
+    pin = (request.form.get("pin") or "").strip()
+    role_ = request.form.get("role") or "kitchen"
+    if not name or len(pin) < 4:
+        flash("Name and a PIN of at least 4 digits are needed.", "")
+        return redirect(url_for("staff"))
+    c = conn()
+    uid = auth.create_user(c, name, role_, pin,
+                           phone=request.form.get("phone"),
+                           lang_=request.form.get("lang") or "en")
+    auth.log(c, "staff.add", f"user {uid}", f"{name} · {role_}")
+    c.close()
+    flash(f"{name} can now sign in with their PIN.", "ok")
+    return redirect(url_for("staff"))
+
+
+@app.route("/staff/<int:user_id>/pin", methods=["POST"])
+def staff_pin(user_id):
+    pin = (request.form.get("pin") or "").strip()
+    if len(pin) < 4:
+        flash("A PIN needs at least 4 digits.", "")
+        return redirect(url_for("staff"))
+    c = conn()
+    auth.set_pin(c, user_id, pin)
+    auth.log(c, "staff.pin", f"user {user_id}", "PIN reset")
+    c.close()
+    flash("PIN changed.", "ok")
+    return redirect(url_for("staff"))
+
+
+@app.route("/staff/<int:user_id>/active", methods=["POST"])
+def staff_active(user_id):
+    on = request.form.get("on") == "1"
+    c = conn()
+    # Deactivated, never deleted — the audit log has to keep pointing at a real
+    # person, and "who delivered this in August" must still have an answer.
+    auth.set_active(c, user_id, on)
+    auth.log(c, "staff.active", f"user {user_id}", "enabled" if on else "disabled")
+    c.close()
+    flash("Access " + ("restored." if on else "removed."), "ok")
+    return redirect(url_for("staff"))
+
+
+@app.route("/audit")
+def audit():
