# Copy to .env.local and fill in. This file is committed; .env.local never is.
#
# [LAW] docs/03 §7 — no credential of any kind belongs in this file or any other
# committed file. The old MERN app leaked live Atlas credentials through exactly
# this kind of example file. Placeholders only, always.

# Neon Postgres — Project -> Connection Details -> Pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Shared secret for calling the Command Center's customer API.
# Must match OG_API_TOKEN in PythonAnywhere's WSGI file.
OG_API_TOKEN=""
OG_API_BASE="https://oggainz.pythonanywhere.com"
